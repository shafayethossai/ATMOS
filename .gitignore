# ============================================================
# ATMOS PROJECT — CENTRAL GITIGNORE
# ============================================================
# BACKEND   → ATMOS-Backend/
# FRONTEND  → ATMOS-Frontend/
# ML API    → ATMOS-ML-API/
# GENERAL   → applies to all parts
# ============================================================


# ── BACKEND ─────────────────────────────────────────────────
ATMOS-Backend/.env
ATMOS-Backend/*.exe
ATMOS-Backend/*.test
ATMOS-Backend/atmos-backend
ATMOS-Backend/tmp/


# ── FRONTEND ─────────────────────────────────────────────────
ATMOS-Frontend/.env
ATMOS-Frontend/.env.local
ATMOS-Frontend/.env.production
ATMOS-Frontend/node_modules/
ATMOS-Frontend/dist/
ATMOS-Frontend/.vite/


# ── ML API ───────────────────────────────────────────────────
ATMOS-ML-API/.env
ATMOS-ML-API/atmos_bundle/
ATMOS-ML-API/atmos_live.db
ATMOS-ML-API/__pycache__/
ATMOS-ML-API/*.pyc
ATMOS-ML-API/*.pyo
ATMOS-ML-API/.env.*
ATMOS-ML-API/*.PublishSettings


# ── GENERAL ──────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.log
*.tmp
.env
.env.*

# Claude Code private files
CLAUDE.md
FRONTEND.md
BACKEND_API.md
BACKEND_GUIDE.md
atmos_main.ino

